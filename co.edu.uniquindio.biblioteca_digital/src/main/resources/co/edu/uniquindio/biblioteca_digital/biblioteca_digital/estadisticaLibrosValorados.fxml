<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Label?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.biblioteca_digital.biblioteca_digital.controllers.EstadisticaLibrosValoradosController">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <top>
        <Label text="Top 3 Libros Más Valorados" style="-fx-font-size: 18px; -fx-padding: 10;" BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <BarChart fx:id="graficaTopLibros" title="Promedio de Calificación"
                  prefWidth="600" prefHeight="400">
            <xAxis>
                <CategoryAxis label="Título"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Promedio"/>
            </yAxis>
        </BarChart>
    </center>
</BorderPane>


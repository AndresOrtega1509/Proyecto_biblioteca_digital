<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.biblioteca_digital.biblioteca_digital.controllers.EstadisticaCaminoCortoController">
    <top>
        <VBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="Camino más corto entre lectores" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="15" alignment="CENTER">
                <Label text="Lector origen:"/>
                <ComboBox fx:id="comboOrigen" promptText="Selecciona lector origen" prefWidth="200"/>
                <Label text="Lector destino:"/>
                <ComboBox fx:id="comboDestino" promptText="Selecciona lector destino" prefWidth="200"/>
                <Button text="Buscar" onAction="#handleBuscarCamino"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" alignment="CENTER">
            <Label text="Camino encontrado:" style="-fx-font-size: 14px;"/>
            <ListView fx:id="listaCamino" prefHeight="250" prefWidth="400"/>
        </VBox>
    </center>
</BorderPane>
